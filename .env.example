# Docker / PostgreSQL
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=navitas_assist
POSTGRES_USER=navitas_app
POSTGRES_PASSWORD=navitas123

# Backend / Spring Boot
# Banco remoto gerenciado: jdbc:postgresql://<host>/<banco>?sslmode=require (acrescente &prepareThreshold=0 se o
# endereco for um pooler em modo transaction, e aponte MIGRATION_DB_* para o endpoint direto).
DB_URL=jdbc:postgresql://localhost:5432/navitas_assist
DB_USER=navitas_app
DB_PASSWORD=navitas123
# Opcionais: conexao propria do Flyway (sem elas, usa DB_*; nao deixe definida vazia) e tamanho do pool.
# MIGRATION_DB_URL=
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=
DB_POOL_MAX=5
SERVER_PORT=8080
SESSION_TIMEOUT=30m
DEADLINE_WARNING_DAYS=7
SESSION_COOKIE_SECURE=false

# E-mails internos: desligados por padrão; fake captura somente em memória.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_PROVIDER=fake
RESEND_API_KEY=
MAIL_FROM=
APP_BASE_URL=
NOTIFICATIONS_EMAIL_POLL_MS=5000
NOTIFICATIONS_EMAIL_BATCH_SIZE=50
# Teto do plano do provedor real (fake não conta), por dia/mês civil de São Paulo; 0 = sem limite.
NOTIFICATIONS_EMAIL_DAILY_LIMIT=100
NOTIFICATIONS_EMAIL_MONTHLY_LIMIT=3000
# Intervalo mínimo entre envios ao provedor real (500 ms = até 2 por segundo).
NOTIFICATIONS_EMAIL_SEND_INTERVAL_MS=500
