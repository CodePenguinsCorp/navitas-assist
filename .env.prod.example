# Production Compose
# Substitua todas as senhas de exemplo por segredos prÃ³prios antes de iniciar.
# O backend recusa senhas de banco publicadas nos exemplos fora de local/test.
FRONTEND_PORT=80
MYSQL_DATABASE=navitas_assist
MYSQL_USER=navitas_app
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Images published by CD
BACKEND_IMAGE=ghcr.io/seu-usuario/seu-repo/backend:latest
FRONTEND_IMAGE=ghcr.io/seu-usuario/seu-repo/frontend:latest

# Backend / Spring Boot
SESSION_TIMEOUT=30m
DEADLINE_WARNING_DAYS=7

# E-mails internos: desligados por padrão; fake captura somente em memória.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_PROVIDER=fake
RESEND_API_KEY=
MAIL_FROM=
APP_BASE_URL=
NOTIFICATIONS_EMAIL_POLL_MS=5000
NOTIFICATIONS_EMAIL_BATCH_SIZE=50
